                <li>Doves Cave<em>20 min</em></li>
                <li>Gjipe Canyon</li>
                <li>Saint Theodore’s Cave</li>
                <li>Pirates Cave</li>
                <li>Dhërmi</li>
                <li>Palasa</li>
                <li>Saint Andrew’s Bay<em>30 min</em></li>
                <li class="big">Grama Bay<em>1–1,5 h</em></li>
              </ol>
