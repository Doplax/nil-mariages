---
// Planificación interactiva «Albania en 11 días» (muestra de portfolio).
// El contenido sale del PDF public/planificaciones/albania-muestra.pdf y, como
// el PDF, está solo en castellano: desde /en y /ca se enlaza aquí igualmente.
// Fotos: public/images/planificaciones/albania/ (WebP, 1200 px como mucho).
// Contorno del mapa: src/data/plans/albania-map.json, generado con
// `node scripts/build-plan-map.mjs`. Las coordenadas de las paradas están en el
// script de abajo (STOPS), sacadas de OpenStreetMap (Nominatim).
import '@fontsource-variable/inter';
import '@fontsource-variable/oswald';
import Logo from '../../components/Logo.astro';
import map from '../../data/plans/albania-map.json';

const pdfUrl = `/visor?src=${encodeURIComponent('/planificaciones/albania-muestra.pdf')}&title=${encodeURIComponent('Albania en 11 días')}`;
const img = (name: string) => `/images/planificaciones/albania/${name}.webp`;
---

<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Albania en 11 días · Nil Mariages</title>
<meta name="description" content="Planificación interactiva de un viaje en coche por Albania del 4 al 14 de septiembre de 2025, por Nil Mariages.">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#091622">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<style is:global>
/* Layout: el mapa se queda fijo a la izquierda y sigue el dia que estas leyendo; los dias corren a la derecha. En movil el mapa se abre como hoja inferior. */
:root {
  --bg: #F1F2F0;
  --surface: #FFFFFF;
  --ink: #15181A;
  --muted: #586064;
  --line: #D8DCDA;
  --red: #C8131B;
  --red-ink: #FFFFFF;
  --sea: #0A7480;
  --alp: #367046;
  --map-sea: #DAE7E9;
  --map-land: #FFFFFF;
  --map-neigh: #E6E8E5;
  --map-border: #B7BFBD;
  --shadow: 0 10px 30px rgba(20, 24, 26, .14);
  --f-display: "Oswald Variable", "Oswald", "Arial Narrow", "Helvetica Neue", Impact, sans-serif;
  --f-body: "Inter Variable", "Inter", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --f-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  /* Marca del portfolio (barra superior y logo), igual en los dos temas */
  --navy: #0e2336;
  --navy-deep: #091622;
  --teal: #5fc9bc;
  --teal-bright: #7ad9cd;
  --teal-deep: #3da093;
  --cream: #f5faf9;
  --hh: 112px;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0F1214; --surface: #171C1F; --ink: #E8ECEA; --muted: #9AA4A8; --line: #2A3236;
    --red: #F0474D; --red-ink: #1A0506; --sea: #43B9C3; --alp: #72BE88;
    --map-sea: #0C191E; --map-land: #1E262A; --map-neigh: #14191C; --map-border: #34403F;
    --shadow: 0 10px 30px rgba(0, 0, 0, .5);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0F1214; --surface: #171C1F; --ink: #E8ECEA; --muted: #9AA4A8; --line: #2A3236;
  --red: #F0474D; --red-ink: #1A0506; --sea: #43B9C3; --alp: #72BE88;
  --map-sea: #0C191E; --map-land: #1E262A; --map-neigh: #14191C; --map-border: #34403F;
  --shadow: 0 10px 30px rgba(0, 0, 0, .5);
  color-scheme: dark;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition: none !important; animation: none !important; } }
body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16.5px/1.6 var(--f-body); -webkit-font-smoothing: antialiased; }
img { max-width: 100%; }
[hidden] { display: none !important; }
a { color: inherit; text-decoration-color: var(--red); text-underline-offset: 3px; }
a:hover { color: var(--red); }
button { font: inherit; color: inherit; }
:focus-visible { outline: 2px solid var(--red); outline-offset: 2px; }
h1, h2, h3 { text-wrap: balance; }
.mono { font-family: var(--f-mono); font-variant-numeric: tabular-nums; }
.wrap { max-width: 1260px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.eyebrow { font: 600 .78rem/1.2 var(--f-body); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin: 0; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

/* Barra del portfolio (no fija) */
.nm-bar { background: var(--navy-deep); color: var(--cream); }
.nm-row { display: flex; align-items: center; justify-content: space-between; gap: 12px 20px; padding-block: 10px; flex-wrap: wrap; }
.nm-back { display: inline-flex; align-items: center; gap: 10px; color: var(--cream); text-decoration: none; }
.nm-back:hover { color: var(--cream); opacity: .85; }
.nm-back > svg { width: 18px; height: 18px; flex: 0 0 auto; }
.nm-crumb { flex: 1; min-width: 0; font-size: .85rem; color: rgba(245, 250, 249, .7); }
.nm-pdf { display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; border: 1px solid rgba(245, 250, 249, .3); color: var(--cream); text-decoration: none; font-size: .88rem; font-weight: 600; }
.nm-pdf:hover { color: var(--navy-deep); background: var(--teal); border-color: var(--teal); }
.nm-pdf svg { width: 16px; height: 16px; }
@media (max-width: 560px) { .nm-crumb { display: none; } }

/* Cabecera fija */
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); z-index: 40; background: var(--bg); }
.top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 30; background: var(--bg); border-bottom: 1px solid var(--line); }
.top-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 10px 6px; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 600 1.05rem/1 var(--f-display); letter-spacing: .08em; text-transform: uppercase; }
.brand i { width: 22px; height: 15px; background: var(--red); border-radius: 2px; display: inline-block; }
.brand span { color: var(--muted); font-weight: 500; }
.nav { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
.nav a { text-decoration: none; font-weight: 600; font-size: .92rem; padding: 6px 10px; border-radius: 6px; color: var(--muted); }
.nav a:hover, .nav a[aria-current="true"] { color: var(--ink); background: var(--surface); }
.strip { display: flex; gap: 6px; overflow-x: auto; padding-block: 4px 10px; scrollbar-width: none; scroll-padding-inline: 16px; }
.strip::-webkit-scrollbar { display: none; }
.chip { flex: 0 0 auto; display: grid; justify-items: center; gap: 1px; min-width: 56px; padding: 5px 8px 6px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); cursor: pointer; transition: background .2s, border-color .2s, color .2s; }
.chip b { font: 600 1.15rem/1 var(--f-display); }
.chip small { font: 500 .68rem/1 var(--f-mono); color: var(--muted); letter-spacing: .02em; }
.chip:hover { border-color: var(--red); }
.chip[aria-current="true"] { background: var(--red); border-color: var(--red); color: var(--red-ink); }
.chip[aria-current="true"] small { color: var(--red-ink); opacity: .85; }

/* Portada */
.hero-photo { display: block; width: 100%; height: clamp(170px, 26vw, 340px); object-fit: cover; object-position: 30% 55%; }
.hero { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px 56px; padding-block: 28px 40px; align-items: end; }
.hero h1 { margin: 6px 0 0; font: 700 clamp(4.4rem, 14vw, 10.5rem)/.84 var(--f-display); text-transform: uppercase; letter-spacing: .005em; }
.hero h1 span { display: block; margin-top: .14em; font-size: .3em; letter-spacing: .06em; color: var(--red); font-weight: 600; }
.dates { margin: 14px 0 0; font: 500 1rem/1.3 var(--f-mono); }
.lead { margin: 16px 0 0; max-width: 58ch; font-size: 1.12rem; color: var(--ink); }
.stats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--ink); }
.stats li { padding: 12px 0 14px; border-bottom: 1px solid var(--line); display: grid; gap: 2px; }
.stats li:not(:nth-child(3n+1)) { padding-left: 14px; border-left: 1px solid var(--line); }
.stats b { font: 600 2.4rem/1 var(--f-display); }
.stats span { font-size: .82rem; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
.cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
.btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 8px; border: 1px solid var(--ink); background: transparent; text-decoration: none; font-weight: 600; cursor: pointer; }
.btn:hover { color: var(--red); border-color: var(--red); }
.btn.solid { background: var(--red); border-color: var(--red); color: var(--red-ink); }
.btn.solid:hover { filter: brightness(1.08); color: var(--red-ink); }
.byline { margin: 18px 0 0; font-size: .85rem; color: var(--muted); }
.byline b { color: var(--ink); }

.checkin { background: var(--red); color: var(--red-ink); }
.checkin p { margin: 0; padding-block: 12px; font: 600 clamp(1rem, 2.4vw, 1.25rem)/1.25 var(--f-display); letter-spacing: .06em; text-transform: uppercase; text-align: center; text-wrap: balance; }

/* Itinerario */
section { scroll-margin-top: calc(var(--hh) + 8px); }
.sec-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 8px 24px; padding-block: 44px 8px; }
.sec-head h2 { margin: 4px 0 0; font: 600 clamp(2rem, 5vw, 3.1rem)/1 var(--f-display); text-transform: uppercase; }
.sec-head p.note { margin: 0; max-width: 46ch; color: var(--muted); font-size: .95rem; }
.itin { display: grid; grid-template-columns: minmax(320px, 430px) minmax(0, 1fr); gap: 44px; align-items: start; padding-bottom: 48px; }
.map-wrap { position: sticky; top: calc(var(--hh) + 14px); }
.map { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; display: flex; flex-direction: column; height: calc(100vh - var(--hh) - 28px); max-height: 880px; min-height: 460px; }
.map-head { display: flex; align-items: center; gap: 8px; padding: 10px 10px 10px 14px; border-bottom: 1px solid var(--line); }
.map-title { flex: 1; min-width: 0; }
.map-title small { display: block; font: 600 .72rem/1.2 var(--f-body); letter-spacing: .14em; text-transform: uppercase; color: var(--red); }
.map-title strong { display: block; font: 500 1.02rem/1.2 var(--f-display); text-transform: uppercase; letter-spacing: .02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.icon-btn { flex: 0 0 auto; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); cursor: pointer; }
.icon-btn:hover { border-color: var(--red); color: var(--red); }
.icon-btn:disabled { opacity: .35; cursor: default; border-color: var(--line); color: inherit; }
.icon-btn svg { width: 16px; height: 16px; }
.pill-btn { flex: 0 0 auto; height: 34px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); cursor: pointer; font-size: .82rem; font-weight: 600; }
.pill-btn:hover, .pill-btn[aria-pressed="true"] { border-color: var(--red); color: var(--red); }
.sheet-close { display: none; }
#map-svg { flex: 1 1 auto; min-height: 0; width: 100%; display: block; background: var(--map-sea); touch-action: manipulation; }
#map-svg .sea { fill: var(--map-sea); }
#map-svg .neigh { fill: var(--map-neigh); stroke: var(--map-border); stroke-width: .8; vector-effect: non-scaling-stroke; }
#map-svg .alb { fill: var(--map-land); stroke: var(--ink); stroke-opacity: .5; stroke-width: 1.2; vector-effect: non-scaling-stroke; }
#map-svg .c-label { fill: var(--muted); font-family: var(--f-display); letter-spacing: .14em; font-weight: 500; }
#map-svg .s-label { fill: var(--sea); font-family: var(--f-body); font-style: italic; letter-spacing: .06em; }
.leg { fill: none; stroke: var(--muted); stroke-opacity: .3; stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; transition: stroke-opacity .3s, stroke-width .3s; }
.leg.mode-car { --c: var(--red); }
.leg.mode-transfer { --c: var(--ink); stroke-dasharray: 6 4; }
.leg.mode-ferry, .leg.mode-boatloop { --c: var(--sea); stroke-dasharray: .5 5; }
.leg.mode-walk { --c: var(--alp); stroke-dasharray: .5 4.5; }
.leg.mode-flight { --c: var(--muted); stroke-dasharray: 7 6; }
.map.overview .leg { stroke: var(--c); stroke-opacity: .9; stroke-width: 2.2; }
.day-legs.is-active .leg { stroke: var(--c); stroke-opacity: 1; stroke-width: 3.4; }
.stop { cursor: pointer; outline: none; }
.stop circle { fill: var(--surface); stroke: var(--ink); stroke-width: 1.6; vector-effect: non-scaling-stroke; transition: fill .2s, stroke .2s; }
.stop.night circle { fill: var(--ink); stroke: var(--surface); }
.stop.on circle { stroke: var(--red); stroke-width: 2.2; }
.stop.night.on circle { fill: var(--red); stroke: var(--surface); }
.stop text { fill: var(--ink); font-family: var(--f-body); font-weight: 700; paint-order: stroke; stroke: var(--map-land); stroke-linejoin: round; opacity: 0; transition: opacity .25s; pointer-events: none; }
.stop.night text, .stop.on text, .stop:hover text, .stop:focus-visible text { opacity: 1; }
.map.has-active .stop.night:not(.on):not(:hover) text { opacity: .5; }
.stop:focus-visible circle { stroke: var(--red); stroke-width: 3; }
#traveller { fill: var(--red); stroke: var(--surface); stroke-width: 2; vector-effect: non-scaling-stroke; pointer-events: none; }
#pulse { fill: none; stroke: var(--red); stroke-width: 2; vector-effect: non-scaling-stroke; pointer-events: none; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 14px; list-style: none; margin: 0; padding: 10px 14px 4px; border-top: 1px solid var(--line); font-size: .82rem; color: var(--muted); }
.legend li { display: flex; align-items: center; gap: 6px; }
.legend svg { width: 26px; height: 8px; overflow: visible; }
.legend .leg { stroke: var(--c); stroke-opacity: 1; stroke-width: 2.4; }
.map-note { margin: 0; padding: 2px 14px 10px; font-size: .74rem; color: var(--muted); }
.fab { display: none; }
.scrim { position: fixed; inset: 0; background: rgba(10, 12, 14, .45); z-index: 55; }

/* Dias */
.days { min-width: 0; }
.day { scroll-margin-top: calc(var(--hh) + 10px); padding-block: 30px 34px; border-top: 1px solid var(--line); }
.day:first-child { border-top: 0; padding-top: 4px; }
.day-head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px; align-items: start; }
.day-num { display: grid; justify-items: start; font-family: var(--f-display); color: var(--muted); line-height: .85; transition: color .3s; }
.day-num small { font-size: .74rem; letter-spacing: .18em; text-transform: uppercase; font-weight: 600; }
.day-num b { font-size: clamp(3.4rem, 7vw, 4.6rem); font-weight: 600; letter-spacing: -.01em; }
.day.is-active .day-num { color: var(--red); }
.day-date { margin: 4px 0 0; font: 500 .9rem/1.2 var(--f-mono); color: var(--muted); }
.day-route { margin: 6px 0 0; font: 600 clamp(1.45rem, 3vw, 2.05rem)/1.08 var(--f-display); text-transform: uppercase; letter-spacing: .01em; }
.day-route i { font-style: normal; color: var(--red); font-weight: 500; }
.tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 10px 0 0; padding: 0; }
.tags li { font-size: .74rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: 3px 8px; border-radius: 4px; background: var(--surface); border: 1px solid var(--line); color: var(--muted); }
.tags li.t-mont { color: var(--alp); border-color: currentColor; }
.tags li.t-mar { color: var(--sea); border-color: currentColor; }
.tags li.t-unesco { color: var(--red); border-color: currentColor; }
.stay { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; margin-top: 18px; padding: 10px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
.stay svg { width: 18px; height: 18px; color: var(--muted); flex: 0 0 auto; }
.stay b { font-weight: 700; }
.stars { color: var(--red); letter-spacing: .1em; font-size: .9rem; }
.regimen { color: var(--muted); font-size: .92rem; }
.stay.none { background: transparent; border-style: dashed; color: var(--muted); }
.keys { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 14px 0 0; padding: 0; }
.keys li { display: inline-flex; align-items: baseline; gap: 6px; padding: 5px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: .9rem; background: var(--bg); }
.keys b { font: 500 .9rem/1 var(--f-mono); font-variant-numeric: tabular-nums; color: var(--ink); }
.photos { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 10px; margin: 18px 0 0; }
.photos figure { margin: 0; min-width: 0; }
.photos button { display: block; width: 100%; padding: 0; border: 0; border-radius: 10px; overflow: hidden; background: var(--line); cursor: zoom-in; }
.photos img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform .5s ease; }
.photos button:hover img { transform: scale(1.04); }
.photos figcaption { margin-top: 6px; font-size: .82rem; color: var(--muted); }
.flow { list-style: none; margin: 22px 0 0; padding: 0; }
.flow > li { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 14px; }
.when { padding-top: 1px; text-align: right; font: 500 .82rem/1.5 var(--f-mono); color: var(--muted); font-variant-numeric: tabular-nums; }
.fixed .when { color: var(--red); font-weight: 500; }
.step { position: relative; padding: 0 0 18px 20px; border-left: 2px solid var(--line); min-width: 0; }
.flow > li:last-child .step { border-left-color: transparent; padding-bottom: 0; }
.step::before { content: ""; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--bg); border: 2px solid var(--muted); }
.fixed .step::before { background: var(--red); border-color: var(--red); }
.step p { margin: 0; max-width: 64ch; }
.step p + p { margin-top: 6px; }
.step .sub { color: var(--muted); font-size: .95rem; }
.place { padding: 0; border: 0; background: none; cursor: pointer; font-weight: 700; color: var(--ink); text-decoration: underline; text-decoration-style: dotted; text-decoration-color: var(--red); text-underline-offset: 3px; text-decoration-thickness: 2px; }
.place:hover { color: var(--red); }
.place::after { content: ""; display: inline-block; width: .55em; height: .55em; margin-left: .25em; border-radius: 50%; border: 2px solid var(--red); vertical-align: .05em; }
.note-box { margin: 18px 0 0; padding: 12px 16px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); font-size: .95rem; }
.note-box h4 { margin: 0 0 4px; font: 600 .8rem/1.2 var(--f-body); letter-spacing: .12em; text-transform: uppercase; color: var(--red); }
.note-box p { margin: 0; }
.note-box ul { margin: 6px 0 0; padding-left: 1.1em; }
.note-box li + li { margin-top: 3px; }
details.more { margin: 16px 0 0; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
details.more summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; font-weight: 700; }
details.more summary::-webkit-details-marker { display: none; }
details.more summary::after { content: "+"; font: 500 1.3rem/1 var(--f-mono); color: var(--red); transition: transform .25s; }
details.more[open] summary::after { transform: rotate(45deg); }
details.more .in { padding: 0 16px 14px; font-size: .96rem; }
details.more .in p { margin: 0 0 8px; max-width: 64ch; }
details.more .in ul { margin: 0; padding-left: 1.1em; }
details.more .in li + li { margin-top: 4px; }
.line-route { overflow-x: auto; margin: 4px -4px 0; padding: 6px 4px 4px; }
.line-route ol { list-style: none; display: flex; gap: 0; margin: 0; padding: 0; width: max-content; counter-reset: st; }
.line-route li { counter-increment: st; position: relative; width: 104px; padding-top: 30px; font-size: .84rem; line-height: 1.25; }
.line-route li::before { content: counter(st); position: absolute; top: 0; left: 0; width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; background: var(--surface); border: 2px solid var(--sea); font: 500 .7rem/1 var(--f-mono); z-index: 1; }
.line-route li::after { content: ""; position: absolute; top: 10px; left: 22px; right: 0; border-top: 2px dotted var(--sea); }
.line-route li:last-child::after { display: none; }
.line-route li.big::before { background: var(--sea); color: var(--surface); }
.line-route.walk li::before { border-color: var(--red); }
.line-route.walk li::after { border-top-color: var(--red); border-top-style: solid; }
.line-route.walk li.big::before { background: var(--red); color: var(--red-ink); }
.line-route em { display: block; font-style: normal; font: 500 .74rem/1.3 var(--f-mono); color: var(--sea); margin-top: 2px; }
.day-nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 22px; }
.day-nav a { font-size: .9rem; font-weight: 600; text-decoration: none; color: var(--muted); }
.day-nav a:hover { color: var(--red); }

/* Antes de ir */
.band { background: var(--surface); border-block: 1px solid var(--line); }
.facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: 0; margin: 18px 0 0; border-top: 2px solid var(--ink); }
.facts div { padding: 12px 14px 14px 0; border-bottom: 1px solid var(--line); min-width: 0; }
.facts dt { font-size: .74rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
.facts dd { margin: 3px 0 0; font-weight: 600; }
.facts dd small { display: block; font-weight: 400; color: var(--muted); font-size: .86rem; }
.info-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(280px, 1fr); gap: 32px; padding-block: 28px 52px; align-items: start; }
.tabs { display: flex; flex-wrap: wrap; gap: 6px; border-bottom: 1px solid var(--line); padding-bottom: 10px; }
.tab { padding: 7px 12px; border-radius: 7px; border: 1px solid var(--line); background: var(--bg); cursor: pointer; font-weight: 600; font-size: .92rem; }
.tab[aria-selected="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.panel { padding-top: 16px; }
.panel h3 { margin: 18px 0 6px; font: 600 1.15rem/1.2 var(--f-display); text-transform: uppercase; letter-spacing: .03em; }
.panel h3:first-child { margin-top: 0; }
.panel p, .panel li { max-width: 66ch; }
.panel p { margin: 0 0 8px; }
.panel ul { margin: 0 0 8px; padding-left: 1.1em; }
.panel li + li { margin-top: 4px; }
.ops { display: grid; gap: 8px; margin: 8px 0 10px; }
.ops div { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); }
.ops b { font-weight: 700; }
.signs { display: flex; flex-wrap: wrap; gap: 18px; margin: 10px 0 14px; }
.sign { display: grid; justify-items: center; gap: 6px; font-size: .85rem; color: var(--muted); text-align: center; }
.sign span { display: grid; place-items: center; width: 74px; height: 74px; border-radius: 50%; background: #FFFFFF; color: #111111; border: 9px solid #D21F25; font: 700 1.25rem/1 var(--f-display); letter-spacing: -.01em; }
.sign span.small { font-size: 1rem; }
.words { display: flex; flex-wrap: wrap; gap: 10px; margin: 6px 0 10px; }
.word { padding: 10px 14px; border-radius: 10px; border: 1px solid var(--line); background: var(--bg); }
.word b { display: block; font: 600 1.25rem/1.1 var(--f-display); letter-spacing: .02em; }
.word span { color: var(--muted); font-size: .9rem; }
.side { display: grid; gap: 16px; }
.card { padding: 16px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); }
.card h3 { margin: 0 0 4px; font: 600 1.2rem/1.1 var(--f-display); text-transform: uppercase; letter-spacing: .03em; }
.card .hint { margin: 0 0 12px; font-size: .86rem; color: var(--muted); }
.fx { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 8px; align-items: end; }
.fx label { display: grid; gap: 4px; font-size: .78rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); min-width: 0; }
.fx input { width: 100%; min-width: 0; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: 500 1.15rem/1.2 var(--f-mono); }
.fx input:focus { border-color: var(--red); outline: none; box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 25%, transparent); }
.fx .swap { padding-bottom: 12px; color: var(--muted); font-family: var(--f-mono); }
.fx-out { margin: 12px 0 0; font: 500 .95rem/1.4 var(--f-mono); }
.presets { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.presets button { padding: 5px 10px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); cursor: pointer; font-size: .82rem; }
.presets button:hover { border-color: var(--red); color: var(--red); }
.links { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
.links a { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-weight: 600; }
.links a span { color: var(--muted); font-weight: 400; font-size: .85rem; }
.links a:hover span { color: var(--red); }

/* Comida */
.food-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 28px; align-items: center; padding-top: 18px; }
.food-top img { width: 100%; border-radius: 12px; display: block; aspect-ratio: 868 / 426; object-fit: cover; }
.filters { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.filters button { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); cursor: pointer; font-weight: 600; font-size: .9rem; }
.filters button[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
.filters button span { font-family: var(--f-mono); font-weight: 400; opacity: .7; margin-left: 4px; }
.tally { margin: 12px 0 0; font-size: .95rem; color: var(--muted); }
.tally b { color: var(--red); font-family: var(--f-mono); }
.dishes { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 12px; list-style: none; margin: 22px 0 0; padding: 0 0 52px; }
.dish { position: relative; padding: 14px 52px 14px 16px; border-radius: 10px; background: var(--surface); border: 1px solid var(--line); min-width: 0; transition: border-color .2s; }
.dish h3 { margin: 0; font: 600 1.18rem/1.15 var(--f-display); letter-spacing: .02em; }
.dish p { margin: 4px 0 0; font-size: .92rem; color: var(--muted); }
.dish .cat { display: block; font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin-bottom: 3px; }
.heart { position: absolute; top: 10px; right: 10px; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line); background: var(--bg); cursor: pointer; color: var(--muted); }
.heart svg { width: 16px; height: 16px; }
.heart[aria-pressed="true"] { background: var(--red); border-color: var(--red); color: var(--red-ink); }
.dish.want { border-color: var(--red); }

/* Maleta */
.pack-top { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; justify-content: space-between; padding-top: 16px; }
.meter { flex: 1 1 320px; display: grid; gap: 8px; }
.meter-text { font-weight: 600; }
.meter-text b { font-family: var(--f-mono); color: var(--red); font-weight: 500; }
.bar { height: 10px; border-radius: 999px; background: var(--line); overflow: hidden; }
.bar i { display: block; height: 100%; width: 0; background: var(--red); border-radius: inherit; transition: width .35s ease; }
.reset { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: .92rem; }
.packs { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 14px; padding: 22px 0 56px; align-items: start; }
.pack { border-radius: 12px; border: 1px solid var(--line); background: var(--surface); overflow: hidden; }
.pack header { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 12px 14px; border-bottom: 1px solid var(--line); }
.pack h3 { margin: 0; font: 600 1.05rem/1.15 var(--f-display); text-transform: uppercase; letter-spacing: .05em; }
.pack header span { font: 500 .85rem/1 var(--f-mono); color: var(--muted); }
.pack.done header span { color: var(--alp); }
.pack.trip { border-color: var(--red); }
.pack.trip h3 { color: var(--red); }
.pack ul { list-style: none; margin: 0; padding: 6px 0; }
.check { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; align-items: start; padding: 7px 14px; cursor: pointer; }
.check:hover { background: var(--bg); }
.check input { appearance: none; -webkit-appearance: none; margin: 1px 0 0; width: 20px; height: 20px; border-radius: 5px; border: 2px solid var(--muted); background: var(--surface); display: grid; place-items: center; cursor: pointer; }
.check input::after { content: ""; width: 10px; height: 6px; border-left: 2.5px solid var(--red-ink); border-bottom: 2.5px solid var(--red-ink); transform: rotate(-45deg) translate(1px, -1px); opacity: 0; }
.check input:checked { background: var(--red); border-color: var(--red); }
.check input:checked::after { opacity: 1; }
.check input:checked + span { color: var(--muted); text-decoration: line-through; text-decoration-color: var(--muted); }
.check small { display: block; color: var(--muted); font-size: .82rem; }

footer { border-top: 1px solid var(--line); }
footer .wrap { display: grid; gap: 6px; padding-block: 24px 36px; font-size: .85rem; color: var(--muted); }
footer p { margin: 0; max-width: 90ch; }
footer b { color: var(--ink); }

/* Visor de fotos */
.lb { position: fixed; inset: 0; z-index: 80; background: rgba(8, 10, 12, .92); display: grid; grid-template-rows: auto minmax(0, 1fr) auto; padding: max(12px, env(safe-area-inset-top, 0px)) max(12px, env(safe-area-inset-right, 0px)) max(12px, env(safe-area-inset-bottom, 0px)) max(12px, env(safe-area-inset-left, 0px)); color: #F2F2F2; }
.lb-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.lb-top span { font: 500 .85rem/1 var(--f-mono); opacity: .8; }
.lb-stage { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 10px; min-height: 0; }
.lb-stage img { max-width: 100%; max-height: 100%; margin: 0 auto; object-fit: contain; border-radius: 6px; min-height: 0; }
.lb-fig { margin: 0; display: grid; height: 100%; min-height: 0; place-items: center; }
.lb button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.08); color: #F2F2F2; cursor: pointer; display: grid; place-items: center; }
.lb button:hover { background: rgba(255,255,255,.18); }
.lb button svg { width: 18px; height: 18px; }
.lb-cap { text-align: center; margin: 10px 0 0; font: 500 1.05rem/1.3 var(--f-display); letter-spacing: .04em; text-transform: uppercase; }

/* Movil y tableta */
@media (max-width: 999px) {
  .hero { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .itin { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .map-wrap { position: static; }
  .map { height: min(76vh, 640px); min-height: 420px; }
  .map.is-sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; height: min(80vh, 680px); min-height: 0; max-height: none; border-radius: 16px 16px 0 0; border-bottom: 0; box-shadow: var(--shadow); padding-bottom: env(safe-area-inset-bottom, 0px); }
  .map.is-sheet .sheet-close { display: grid; }
  .fab { position: fixed; right: max(16px, env(safe-area-inset-right, 0px)); bottom: max(16px, env(safe-area-inset-bottom, 0px)); z-index: 50; display: inline-flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 999px; border: 0; background: var(--red); color: var(--red-ink); font-weight: 700; box-shadow: var(--shadow); cursor: pointer; }
  .fab svg { width: 18px; height: 18px; }
  .info-grid { grid-template-columns: minmax(0, 1fr); }
  .food-top { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 560px) {
  body { font-size: 16px; }
  .nav { display: none; }
  .stats b { font-size: 2rem; }
  .flow > li { grid-template-columns: 52px minmax(0, 1fr); gap: 10px; }
  .when { font-size: .74rem; }
  .day-head { gap: 12px; }
  .ops div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  .fx { grid-template-columns: minmax(0, 1fr); }
  .fx .swap { display: none; }
  .lb-stage { grid-template-columns: minmax(0, 1fr); }
  .lb-stage > button { display: none; }
}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-bed" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 18V6M3 14h18v4M21 14v-2a3 3 0 0 0-3-3h-7v5M7 11.5a1.5 1.5 0 1 0 0-.01"/></symbol>
  <symbol id="i-prev" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7"/></symbol>
  <symbol id="i-next" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></symbol>
  <symbol id="i-map" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14"/></symbol>
  <symbol id="i-heart" viewBox="0 0 24 24"><path fill="currentColor" d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.1 5.3 3 1.7-1.9 3.2-3 5.3-3 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/></symbol>
</svg>

<div class="nm-bar">
  <div class="wrap nm-row">
    <a class="nm-back" id="nm-back" href="/#planificaciones" data-astro-reload aria-label="Volver al portfolio de Nil Mariages"><svg><use href="#i-prev"/></svg><Logo variant="cream" tagline={false} /></a>
    <span class="nm-crumb">Planificaciones · versión interactiva</span>
    <a class="nm-pdf" href={pdfUrl} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>Ver el PDF</a>
  </div>
</div>

<header class="top" id="top">
  <div class="wrap top-row">
    <a class="brand" href="#inicio" aria-label="Albania 2025, volver arriba"><i aria-hidden="true"></i>Albania <span>2025</span></a>
    <nav class="nav" aria-label="Secciones">
      <a href="#ruta">Ruta</a>
      <a href="#antes">Antes de ir</a>
      <a href="#comida">Comida</a>
      <a href="#maleta">Maleta</a>
    </nav>
  </div>
  <div class="wrap">
    <div class="strip" id="strip" role="navigation" aria-label="Días del viaje"></div>
  </div>
</header>

<main>
<section id="inicio" aria-label="Portada">
  <img class="hero-photo" src={img('berat-panorama')} alt="Casas otomanas blancas en la ladera de Berat">
  <div class="wrap hero">
    <div>
      <p class="eyebrow">Shqipëria · Planificación de viaje</p>
      <h1>Albania<span>en 11 días</span></h1>
      <p class="dates">Jueves 4 – domingo 14 de septiembre de 2025</p>
      <p class="lead">Un viaje en coche de norte a sur: el ferri del lago Koman, el paso de Valbonë a Theth, Berat, Gjirokastër y Butrinto, y dos días en barco por la Riviera albanesa.</p>
      <div class="cta">
        <a class="btn solid" href="#dia-1">Empezar por el día 1</a>
        <a class="btn" href="#ruta">Ver la ruta en el mapa</a>
      </div>
      <p class="byline">Planificación de <b>Nil Mariages</b> · Muestra de portfolio, no reproducir</p>
    </div>
    <ul class="stats" aria-label="El viaje en cifras">
      <li><b>11</b><span>días</span></li>
      <li><b>10</b><span>noches</span></li>
      <li><b>8</b><span>alojamientos</span></li>
      <li><b>3</b><span>sitios UNESCO</span></li>
      <li><b>2</b><span>tours en barco</span></li>
      <li><b>1</b><span>trekking</span></li>
    </ul>
  </div>
</section>

<div class="checkin"><div class="wrap"><p>Acordaos de hacer el check-in 24 horas antes de cada vuelo</p></div></div>

<section id="ruta" aria-labelledby="ruta-h">
  <div class="wrap sec-head">
    <div>
      <p class="eyebrow">Día a día</p>
      <h2 id="ruta-h">La ruta</h2>
    </div>
    <p class="note">El mapa sigue el día que estás leyendo. Toca un lugar subrayado para verlo en el mapa, o usa las flechas ← → del teclado para cambiar de día.</p>
  </div>
  <div class="wrap itin">
    <div class="map-wrap" id="map-wrap">
      <figure class="map overview" id="map">
        <div class="map-head">
          <div class="map-title" aria-live="polite"><small id="map-kicker">Todo el viaje</small><strong id="map-label">Barcelona → Tiranë → … → Barcelona</strong></div>
          <button class="icon-btn" id="map-prev" type="button" aria-label="Día anterior"><svg><use href="#i-prev"/></svg></button>
          <button class="icon-btn" id="map-next" type="button" aria-label="Día siguiente"><svg><use href="#i-next"/></svg></button>
          <button class="pill-btn" id="map-all" type="button" aria-pressed="true">Todo</button>
          <button class="icon-btn sheet-close" id="map-close" type="button" aria-label="Cerrar el mapa"><svg><use href="#i-close"/></svg></button>
        </div>
        <svg id="map-svg" viewBox={`0 0 ${map.W} ${map.H}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="Mapa de Albania con la ruta del viaje">
          <rect class="sea" x="-2000" y="-2000" width="5000" height="5000"/>
          <path class="neigh" d={map.neighbours}/>
          <path class="alb" d={map.main}/>
          <g id="labels"></g>
          <g id="legs"></g>
          <circle id="pulse" r="0" opacity="0"/>
          <g id="stops"></g>
          <circle id="traveller" r="0"/>
        </svg>
        <ul class="legend" aria-label="Leyenda">
          <li><svg viewBox="0 0 26 8"><path class="leg mode-car" d="M1 4H25"/></svg>Coche</li>
          <li><svg viewBox="0 0 26 8"><path class="leg mode-transfer" d="M1 4H25"/></svg>Traslado</li>
          <li><svg viewBox="0 0 26 8"><path class="leg mode-ferry" d="M1 4H25"/></svg>Barco y ferri</li>
          <li><svg viewBox="0 0 26 8"><path class="leg mode-walk" d="M1 4H25"/></svg>A pie</li>
          <li><svg viewBox="0 0 26 8"><path class="leg mode-flight" d="M1 4H25"/></svg>Avión</li>
        </ul>
        <p class="map-note">Las líneas unen las paradas, no siguen la carretera. Punto relleno: se duerme allí. Contorno: Natural Earth; coordenadas: OpenStreetMap.</p>
      </figure>
    </div>

    <div class="days" id="days">

      <!-- DIA 1 -->
      <article class="day" id="dia-1" data-day="1">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>01</b></div>
          <div>
            <p class="day-date">Jueves 4 sep</p>
            <h3 class="day-route">Barcelona <i>→</i> Tiranë</h3>
            <ul class="tags"><li>Vuelo</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Forest Park Hotel Krujë</b><span class="stars" aria-label="4 estrellas">★★★★</span><span class="regimen">Alojamiento y desayuno</span></div>
        <ul class="keys">
          <li><b>22:35</b>despegue</li>
          <li><b>W4 5154</b>Wizz Air</li>
          <li><b>T2</b>El Prat</li>
        </ul>
        <ol class="flow">
          <li><span class="when">2 h antes</span><div class="step"><p>Llegad al aeropuerto de Barcelona – El Prat, terminal 2. Como no lleváis equipaje facturado, id directos al control de seguridad.</p></div></li>
          <li class="fixed"><span class="when">22:35</span><div class="step"><p>Sale el vuelo W4 5154 de Wizz Air con dirección <button class="place" type="button" data-stop="tia">Tirana</button>.</p></div></li>
        </ol>
        <div class="note-box"><h4>Equipaje permitido por persona</h4><p>Una pieza de equipaje de mano de 40 × 30 × 20 cm como máximo, según las normas de la aerolínea (pueden cambiar).</p></div>
        <nav class="day-nav" aria-label="Cambiar de día"><span></span><a href="#dia-2">Día 2 →</a></nav>
      </article>

      <!-- DIA 2 -->
      <article class="day" id="dia-2" data-day="2">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>02</b></div>
          <div>
            <p class="day-date">Viernes 5 sep</p>
            <h3 class="day-route">Tiranë <i>→</i> Krujë <i>→</i> Shkodër</h3>
            <ul class="tags"><li>Coche de alquiler</li><li>Castillos</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Centropolis Apartments</b><span class="stars" aria-label="3 estrellas">★★★</span><span class="regimen">Sólo alojamiento</span></div>
        <ul class="keys">
          <li><b>01:05</b>llegada a Tirana</li>
          <li><b>500 €</b>depósito del coche</li>
          <li><b>85 km</b>≈ 1 h 40 Krujë → Shkodër</li>
        </ul>
        <div class="photos">
          <figure><button type="button" data-lb="Krujë"><img src={img('kruje')} alt="Krujë con su castillo en lo alto" loading="lazy"></button><figcaption>Krujë</figcaption></figure>
          <figure><button type="button" data-lb="Castillo de Rozafa, Shkodër"><img src={img('rozafa')} alt="Castillo de Rozafa visto desde el aire" loading="lazy"></button><figcaption>Castillo de Rozafa, Shkodër</figcaption></figure>
        </div>
        <ol class="flow">
          <li class="fixed"><span class="when">01:05</span><div class="step"><p>Llegada al aeropuerto de <button class="place" type="button" data-stop="tia">Tirana</button>. Pasad el control de pasaportes y, a la salida de la terminal, seguid el bono de alquiler hasta la oficina de Green Motion.</p></div></li>
          <li><span class="when">+30 min</span><div class="step"><p>Con el coche ya revisado, media hora hasta el hotel en Krujë. Check-in y a descansar.</p></div></li>
          <li><span class="when">Mañana</span><div class="step"><p><button class="place" type="button" data-stop="kruje">Krujë</button>, a diez minutos. Empezad en el mirador del castillo y bajad por el Antiguo Bazar, con alfombras tejidas a mano, cerámica, bordados y cobre, hasta la Mezquita Kruja Murad Bey.</p><p class="sub">Dentro del castillo: Museo Nacional Gjergj Kastrioti Skanderbeg, Torre de vigilancia, Museo Etnográfico en una casa otomana y el santuario bektashi Teqeja e Dollmës.</p></div></li>
          <li><span class="when">85 km</span><div class="step"><p>Hacia el norte, cerca de una hora y cuarenta minutos hasta Shkodër.</p></div></li>
          <li><span class="when">Tarde</span><div class="step"><p>Subid al <button class="place" type="button" data-stop="shkoder">Castillo de Rozafa</button>, sobre la confluencia de los ríos Buna y Drin, y a sus pies la Mezquita de Plomo. Check-in y el coche bien aparcado: no lo necesitaréis en dos días.</p><p class="sub">Paseo por el centro: Mezquita Ebu Bekr, Iglesia de la Natividad de Cristo, calle Kole Idromeno, calle G’juhadol y Catedral de San Esteban.</p></div></li>
          <li><span class="when">Noche</span><div class="step"><p>Cena con pescado del lago o guisos tradicionales, y pronto al hotel.</p></div></li>
        </ol>
        <details class="more">
          <summary>Recoger el coche de alquiler</summary>
          <div class="in">
            <p>Documentos originales, sin fotocopias, a nombre del conductor titular (Nil Mariages Nebot):</p>
            <ul>
              <li>Tarjeta de crédito VISA o Mastercard.</li>
              <li>DNI o pasaporte.</li>
              <li>Permiso de conducir válido, con el internacional.</li>
            </ul>
            <p style="margin-top:10px">La Cobertura Premium ya está incluida. Si os ofrecen su seguro, decid que no y manteneos firmes. El depósito es de 500 € (está en el bono) y hay que pagar 25 € por recoger fuera del horario de oficina.</p>
            <p>Antes de arrancar, haced fotos y vídeos del exterior y del interior: golpes, arañazos y desperfectos que ya tenga. Comprobad también la rueda de repuesto, el chaleco y el triángulo.</p>
          </div>
        </details>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-1">← Día 1</a><a href="#dia-3">Día 3 →</a></nav>
      </article>

      <!-- DIA 3 -->
      <article class="day" id="dia-3" data-day="3">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>03</b></div>
          <div>
            <p class="day-date">Sábado 6 sep</p>
            <h3 class="day-route">Shkodër <i>→</i> Lago Koman <i>→</i> Valbonë</h3>
            <ul class="tags"><li class="t-mont">Montaña</li><li class="t-mar">Ferri</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Guesthouse Demushi</b><span class="stars" aria-label="3 estrellas">★★★</span><span class="regimen">Alojamiento y desayuno</span></div>
        <ul class="keys">
          <li><b>06:30</b>en la puerta del Hotel Rozafa</li>
          <li><b>06:45</b>sale el transfer</li>
          <li><b>≈ 2 h</b>de ferri</li>
        </ul>
        <div class="photos">
          <figure><button type="button" data-lb="Lago Koman"><img src={img('koman')} alt="El lago Koman entre paredes de roca" loading="lazy"></button><figcaption>Lago Koman</figcaption></figure>
          <figure><button type="button" data-lb="Valle de Valbonë"><img src={img('valbone')} alt="El valle de Valbonë rodeado de picos" loading="lazy"></button><figcaption>Valle de Valbonë</figcaption></figure>
        </div>
        <ol class="flow">
          <li class="fixed"><span class="when">06:30</span><div class="step"><p>En punto en la puerta del Hotel Rozafa. El transfer sale a las 06:45 y no espera a nadie: unas dos horas por carreteras de montaña cada vez más estrechas.</p></div></li>
          <li><span class="when">Koman</span><div class="step"><p>Tras un túnel excavado en la roca, el embarcadero de <button class="place" type="button" data-stop="koman">Koman</button>. El ferri público tarda unas dos horas hasta Fierzë, entre cañones y aguas verde esmeralda. Una de las travesías más bonitas de Europa.</p></div></li>
          <li class="fixed"><span class="when">≈ 12:00</span><div class="step"><p>En el muelle de <button class="place" type="button" data-stop="fierze">Fierzë</button> os espera otro traslado: aproximadamente una hora hasta el valle de Valbonë.</p></div></li>
          <li><span class="when">Check-in</span><div class="step"><p>En la guesthouse de <button class="place" type="button" data-stop="valbone">Valbonë</button>, reservad la cena y encargad el <em>lunchbox</em> para el trekking de mañana.</p></div></li>
          <li><span class="when">Tarde</span><div class="step"><p>Tarde libre: paseo por las praderas y los puentes de madera, baño en Buga Dam o un té en la terraza viendo cómo cae la luz sobre las cumbres.</p></div></li>
          <li><span class="when">Noche</span><div class="step"><p>Cenad temprano y a descansar: mañana toca madrugar.</p></div></li>
        </ol>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-2">← Día 2</a><a href="#dia-4">Día 4 →</a></nav>
      </article>

      <!-- DIA 4 -->
      <article class="day" id="dia-4" data-day="4">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>04</b></div>
          <div>
            <p class="day-date">Domingo 7 sep</p>
            <h3 class="day-route">Valbonë <i>→</i> Theth <i>→</i> Shkodër</h3>
            <ul class="tags"><li class="t-mont">Trekking</li><li class="t-mont">Alpes albaneses</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Centropolis Apartments</b><span class="stars" aria-label="3 estrellas">★★★</span><span class="regimen">Sólo alojamiento</span></div>
        <ul class="keys">
          <li><b>Valbona Pass</b>de valle a valle</li>
          <li><b>16:45</b>Mini Market Jezerca</li>
          <li><b>≈ 2 h</b>traslado a Shkodër</li>
        </ul>
        <div class="photos">
          <figure><button type="button" data-lb="Ruta de Valbonë a Theth"><img src={img('valbona-pass')} alt="Senderista ante los picos de los Alpes albaneses" loading="lazy"></button><figcaption>Ruta de Valbonë a Theth</figcaption></figure>
          <figure><button type="button" data-lb="Iglesia de Theth"><img src={img('theth')} alt="La iglesia de piedra de Theth con montañas detrás" loading="lazy"></button><figcaption>Iglesia de Theth</figcaption></figure>
        </div>
        <ol class="flow">
          <li><span class="when">Salida</span><div class="step"><p>La ruta empieza a la altura del Fusha e Gjes Hotel, siguiendo el cauce de un río seco. Si la guesthouse os acerca en coche hasta donde se puede, os ahorráis unos 3 km.</p></div></li>
          <li><span class="when">Tramo 1</span><div class="step"><p>Subida por el bosque hasta una pradera con un pequeño refugio y una fuente. Primera pausa.</p></div></li>
          <li><span class="when">Tramo 2</span><div class="step"><p>El tramo más exigente, casi sin sombra, hasta el paso entre los dos valles: el punto más alto y el mejor mirador. Buen sitio para sentarse, comer algo y hacer fotos.</p></div></li>
          <li><span class="when">Bajada</span><div class="step"><p>Pronunciada y dura para las rodillas: con calma, entre bosques y praderas, hasta <button class="place" type="button" data-stop="theth">Theth</button>.</p></div></li>
          <li><span class="when">Theth</span><div class="step"><p>La Iglesia de Theth, que sobrevivió a décadas de aislamiento comunista, y la torre Kulla e Ngujimit, ligada al Kanun, el código de leyes consuetudinarias albanés.</p></div></li>
          <li class="fixed"><span class="when">16:45</span><div class="step"><p>Quince minutos antes de las 17:00, en el Mini Market Jezerca. Traslado de unas dos horas de vuelta a <button class="place" type="button" data-stop="shkoder">Shkodër</button>.</p></div></li>
        </ol>
        <div class="note-box">
          <h4>Para el trekking</h4>
          <ul>
            <li>Marcas blancas y rojas, pero pocos carteles. Si dudáis, los pastores os indicarán aunque no hablen inglés.</li>
            <li>Llevad la ruta en <a href="https://apps.apple.com/es/app/maps-me-mapas-sin-conexi%C3%B3n/id510623322" target="_blank" rel="noopener">Maps.me</a>, que funciona sin conexión.</li>
            <li>Gorra, crema solar y agua suficiente: el sol castiga en la subida.</li>
            <li><a href="https://es.wikiloc.com/rutas-senderismo/valbone-theth-albania-144517178" target="_blank" rel="noopener">La ruta en Wikiloc</a></li>
          </ul>
        </div>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-3">← Día 3</a><a href="#dia-5">Día 5 →</a></nav>
      </article>

      <!-- DIA 5 -->
      <article class="day" id="dia-5" data-day="5">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>05</b></div>
          <div>
            <p class="day-date">Lunes 8 sep</p>
            <h3 class="day-route">Shkodër <i>→</i> Berat</h3>
            <ul class="tags"><li class="t-unesco">UNESCO</li><li>Ciudad otomana</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Mili Hotel</b><span class="regimen">Alojamiento y desayuno</span></div>
        <ul class="keys">
          <li><b>196 km</b>≈ 3 h</li>
          <li><b>A pie</b>por el casco histórico</li>
        </ul>
        <div class="photos">
          <figure><button type="button" data-lb="Berat"><img src={img('berat')} alt="Casas blancas de Berat en terrazas sobre la ladera al atardecer" loading="lazy"></button><figcaption>Berat</figcaption></figure>
        </div>
        <ol class="flow">
          <li><span class="when">196 km</span><div class="step"><p>Uno de los tramos más largos: unas tres horas por colinas, zonas rurales y pueblos pequeños. Al llegar a <button class="place" type="button" data-stop="berat">Berat</button>, aparcad y seguid a pie.</p></div></li>
          <li><span class="when">Castillo</span><div class="step"><p>El Castillo de Berat sigue habitado. Dentro: el Museo Nacional Iconográfico Onufri en la Catedral de la Dormición, la Capilla de la Sagrada Trinidad y las ruinas de la Mezquita Roja.</p><p class="sub">Desde el mirador se ven Mangalem y Gorica, con sus casas blancas en terrazas, y el río Osum.</p></div></li>
          <li><span class="when">Gorica</span><div class="step"><p>Bajando, la Iglesia de San Miguel. Cruzad el Puente de Gorica, de piedra y del siglo XVIII, pasead por el barrio y acercaos al Ura e Varur, el puente colgante.</p></div></li>
          <li><span class="when">Mangalem</span><div class="step"><p>Arquitectura otomana: Mezquita de los Solteros, Mezquita del Rey (la más antigua de Berat) y Mezquita de Plomo. También la Catedral de San Demetrio.</p></div></li>
          <li><span class="when">Atardecer</span><div class="step"><p>Una terraza en el Bulevardi Republika, con el río delante, mientras el sol dora las fachadas.</p></div></li>
        </ol>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-4">← Día 4</a><a href="#dia-6">Día 6 →</a></nav>
      </article>

      <!-- DIA 6 -->
      <article class="day" id="dia-6" data-day="6">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>06</b></div>
          <div>
            <p class="day-date">Martes 9 sep</p>
            <h3 class="day-route">Berat <i>→</i> Cañón de Langarica <i>→</i> Gjirokastër</h3>
            <ul class="tags"><li>El tramo más largo</li><li class="t-mont">Cañón</li><li class="t-unesco">UNESCO</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Elisavet’s Room</b><span class="regimen">Sólo alojamiento</span></div>
        <ul class="keys">
          <li><b>278 km</b>≈ 4 h 30</li>
          <li><b>+1 h</b>desvío a Langarica</li>
          <li><b>1 h 20</b>Langarica → Gjirokastër</li>
        </ul>
        <div class="photos">
          <figure><button type="button" data-lb="Puente de Bënjë, Cañón de Langarica"><img src={img('puente-benje')} alt="Puente otomano de piedra sobre el río Langarica" loading="lazy"></button><figcaption>Puente de Bënjë</figcaption></figure>
          <figure><button type="button" data-lb="Gjirokastër"><img src={img('gjirokaster')} alt="Torre del reloj del castillo de Gjirokastër" loading="lazy"></button><figcaption>Gjirokastër</figcaption></figure>
        </div>
        <ol class="flow">
          <li><span class="when">278 km</span><div class="step"><p>El tramo de coche más largo del viaje, por montañas, valles y pueblos poco transitados. El Cañón de Osumi no es recomendable sin 4x4; en su lugar, un desvío de una hora al Cañón de Langarica.</p></div></li>
          <li><span class="when">Langarica</span><div class="step"><p>En <button class="place" type="button" data-stop="benje">Bënjë</button>, pueblo de aguas termales, un puente otomano de piedra marca la entrada al cañón. Paredes de caliza de hasta 150 metros, agua turquesa y pozas templadas para bañarse. En verano, tramos vadeando el río.</p></div></li>
          <li><span class="when">Mediodía</span><div class="step"><p>Una hora y veinte hasta <button class="place" type="button" data-stop="gjirokaster">Gjirokastër</button>, “la ciudad de piedra” por sus tejados de pizarra. Ciudad natal de Enver Hoxha. Comida y check-in.</p></div></li>
          <li><span class="when">Tarde</span><div class="step"><p>Skënduli House y Zekate House, dos casas otomanas; el Bazar y su mezquita; el Obelisco de la Educación, mirador sobre el casco antiguo, y el Cold War Tunnel, construido en la dictadura.</p></div></li>
          <li><span class="when">Castillo</span><div class="step"><p>Uno de los más grandes de los Balcanes, con vistas al valle del Drino. Museo de armas, la Clock Tower y el escenario del Festival Nacional de Folklore.</p></div></li>
          <li><span class="when">Atardecer</span><div class="step"><p>Si da tiempo, el Ali Pasha Bridge, un antiguo acueducto en las afueras.</p></div></li>
        </ol>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-5">← Día 5</a><a href="#dia-7">Día 7 →</a></nav>
      </article>

      <!-- DIA 7 -->
      <article class="day" id="dia-7" data-day="7">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>07</b></div>
          <div>
            <p class="day-date">Miércoles 10 sep</p>
            <h3 class="day-route">Gjirokastër <i>→</i> Ksamil</h3>
            <ul class="tags"><li class="t-mar">Playa</li><li class="t-unesco">UNESCO</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Hotel Perla Ksamil</b><span class="stars" aria-label="3 estrellas">★★★</span><span class="regimen">Alojamiento y desayuno</span></div>
        <ul class="keys">
          <li><b>65 km</b>≈ 1 h 15</li>
          <li><b>Blue Eye</b>parada a medio camino</li>
        </ul>
        <div class="photos">
          <figure><button type="button" data-lb="Blue Eye (Syri i Kaltër)"><img src={img('blue-eye')} alt="El manantial azul intenso del Blue Eye" loading="lazy"></button><figcaption>Blue Eye (Syri i Kaltër)</figcaption></figure>
          <figure><button type="button" data-lb="Ksamil"><img src={img('ksamil')} alt="Agua turquesa frente a una isla en Ksamil" loading="lazy"></button><figcaption>Ksamil</figcaption></figure>
        </div>
        <ol class="flow">
          <li><span class="when">Mañana</span><div class="step"><p>A medio camino, el <button class="place" type="button" data-stop="blueeye">Blue Eye</button>: un manantial con forma de iris que brota de una cueva de más de 50 metros, según las estimaciones. Ya no se puede nadar; se ve desde pasarelas y miradores.</p></div></li>
          <li><span class="when">Butrinto</span><div class="step"><p>Directos a <button class="place" type="button" data-stop="butrint">Butrinto</button>, dentro de un parque natural: anfiteatro romano, termas, basílica paleocristiana, baptisterio con mosaicos, Puerta del León y murallas medievales.</p></div></li>
          <li><span class="when">Comida</span><div class="step"><p>Restaurante y check-in en <button class="place" type="button" data-stop="ksamil">Ksamil</button>.</p></div></li>
          <li><span class="when">Tarde</span><div class="step"><p>Playa hasta el atardecer. Elegid:</p><p class="sub"><b>Ksamil Beach</b>, la más famosa, con islas a las que se llega nadando, en kayak o en barca. <b>Mirror Beach</b>, más salvaje y buena para snorkel. <b>Plazhi i Manastirit</b>, la más tranquila, junto a un antiguo monasterio.</p></div></li>
        </ol>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-6">← Día 6</a><a href="#dia-8">Día 8 →</a></nav>
      </article>

      <!-- DIA 8 -->
      <article class="day" id="dia-8" data-day="8">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>08</b></div>
          <div>
            <p class="day-date">Jueves 11 sep</p>
            <h3 class="day-route">Ksamil <i>→</i> Sarandë <i>→</i> Porto Palermo <i>→</i> Himarë</h3>
            <ul class="tags"><li class="t-mar">Barco</li><li class="t-mar">Snorkel</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Faidra</b><span class="stars" aria-label="4 estrellas">★★★★</span><span class="regimen">Sólo alojamiento</span></div>
        <ul class="keys">
          <li><b>09:45</b>punto de encuentro</li>
          <li><b>10:00–16:00</b>tour en barco</li>
          <li><b>25 min</b>Ksamil → Sarandë</li>
        </ul>
        <div class="photos">
          <figure><button type="button" data-lb="Playa de Krorëzë"><img src={img('kroreze')} alt="Cala de agua turquesa con rocas y barcas" loading="lazy"></button><figcaption>Playa de Krorëzë</figcaption></figure>
          <figure><button type="button" data-lb="Castillo de Porto Palermo"><img src={img('porto-palermo')} alt="Fortaleza de Porto Palermo sobre la bahía" loading="lazy"></button><figcaption>Castillo de Porto Palermo</figcaption></figure>
        </div>
        <ol class="flow">
          <li><span class="when">25 min</span><div class="step"><p>De Ksamil a <button class="place" type="button" data-stop="sarande">Sarandë</button>.</p></div></li>
          <li class="fixed"><span class="when">09:45</span><div class="step"><p>Quince minutos antes de las 10:00 en el punto de encuentro: el embarque suele ser puntual. Tour en barco por Kroreza y sus cuevas con snorkel.</p></div></li>
          <li><span class="when">A bordo</span><div class="step"><p>Calas a las que no se llega por tierra y el momento estrella: varias horas en la Playa de Krorëzë, arena blanca y agua turquesa casi virgen.</p></div></li>
          <li class="fixed"><span class="when">≈ 16:00</span><div class="step"><p>Fin del tour y carretera hacia el norte. Playas de camino: Ana’s Beach y Bajkam Cove en Lukovë, Heart Beach y Porto Palermo Beach.</p></div></li>
          <li><span class="when">Atardecer</span><div class="step"><p>El <button class="place" type="button" data-stop="portopalermo">Castillo de Porto Palermo</button>, de origen veneciano y reforzado por Ali Pasha de Tepelena, sobre una península.</p></div></li>
          <li><span class="when">Noche</span><div class="step"><p>Check-in en <button class="place" type="button" data-stop="himare">Himarë</button> y cena en el paseo marítimo.</p></div></li>
        </ol>
        <details class="more">
          <summary>Paradas del barco</summary>
          <div class="in">
            <div class="line-route" tabindex="0" aria-label="Paradas del tour en barco, en orden">
              <ol>
                <li>Cueva de las Tortugas</li>
                <li>Plazhi i Ushtarit</li>
                <li>Qefal Beach<em>snorkel</em></li>
                <li>Kakomë Beach</li>
                <li class="big">Playa de Krorëzë<em>varias horas</em></li>
              </ol>
            </div>
            <p style="margin-top:10px">Llevad bañador, toalla, crema solar y algo de ropa ligera para protegeros del sol a bordo.</p>
          </div>
        </details>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-7">← Día 7</a><a href="#dia-9">Día 9 →</a></nav>
      </article>

      <!-- DIA 9 -->
      <article class="day" id="dia-9" data-day="9">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>09</b></div>
          <div>
            <p class="day-date">Viernes 12 sep</p>
            <h3 class="day-route">Himarë</h3>
            <ul class="tags"><li class="t-mar">Barco</li><li class="t-mar">Riviera</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Faidra</b><span class="stars" aria-label="4 estrellas">★★★★</span><span class="regimen">Sólo alojamiento</span></div>
        <ul class="keys">
          <li><b>09:45</b>punto de encuentro</li>
          <li><b>10:00</b>Grama Bay Tour</li>
          <li><b>≈ 15:00</b>vuelta a Himarë</li>
        </ul>
        <div class="photos">
          <figure><button type="button" data-lb="Grama Bay"><img src={img('grama-bay')} alt="Cala de arena clara entre acantilados" loading="lazy"></button><figcaption>Grama Bay</figcaption></figure>
        </div>
        <ol class="flow">
          <li class="fixed"><span class="when">09:45</span><div class="step"><p>Quince minutos antes en el punto de encuentro de <button class="place" type="button" data-stop="himare">Himarë</button>.</p></div></li>
          <li class="fixed"><span class="when">10:00</span><div class="step"><p>Unas cinco horas de navegación por la costa donde la montaña cae al mar: acantilados, cuevas y calas con paradas para nadar y hacer snorkel.</p></div></li>
          <li><span class="when">Grama</span><div class="step"><p><button class="place" type="button" data-stop="grama">Grama Bay</button>: agua turquesa y paredes de roca con inscripciones que dejaron marineros y viajeros durante siglos. Entre una hora y hora y media de baño.</p></div></li>
          <li class="fixed"><span class="when">≈ 15:00</span><div class="step"><p>De vuelta, tarde en una playa de Himarë: Filikuri, Stone Pocket, Andreas o Aquarium Beach, para muchos la mejor de Albania.</p></div></li>
          <li><span class="when">Atardecer</span><div class="step"><p>Potami Beach, abierta al mar Jónico, o el Castillo de Himarë, con la costa y las montañas a la vez.</p></div></li>
        </ol>
        <details class="more" open>
          <summary>Las 15 paradas del Grama Bay Tour</summary>
          <div class="in">
            <div class="line-route" tabindex="0" aria-label="Paradas del Grama Bay Tour, en orden">
              <ol>
                <li>Livadhi</li>
                <li>Aquarium</li>
                <li>Jalë</li>
                <li>Goats Beach<em>baño 10 min</em></li>
                <li>Couples Bay</li>
                <li>Marble Beach</li>
