    ["salado", "Perime ne Zgare", "Verduras a la parrilla, como plato principal o acompañamiento."],
    ["salado", "Pescado y marisco", "Fresco y económico, servido de forma sencilla para resaltar el sabor."],
    ["salado", "Shapkat", "Pastel de maíz con queso feta, eneldo y espinacas, típico de Gjirokastër."],
    ["salado", "Gjizë", "Queso cuajado seco, tipo ricota agria, solo o como relleno."],
    ["salado", "Flija", "Plato en capas con relleno de aceite, mantequilla y yogur o kaymak."],
    ["dulce", "Baklava", "Pastel otomano de masa filo con nueces o pistachos y sirope, en todas las pastelerías."],
    ["dulce", "Trilece", "Bizcocho bañado en tres leches (condensada, evaporada y crema) con caramelo."],
    ["dulce", "Qumështor", "Natilla al horno de huevos, leche y mantequilla."],
    ["dulce", "Ballokume", "Galletas de harina de maíz, típicas de la fiesta de Dita e Verës."],
    ["bebida", "Rakija", "Aguardiente fuerte de frutas (uva, ciruela, pera…), muy de celebraciones."]
  ];
  var CAT = { salado: "Salado", dulce: "Dulce", bebida: "Bebida" };
  var want = store.get("albania-comida-v1", []);
  if (!Array.isArray(want)) want = [];
  var dishesEl = $("#dishes"), filter = "all";
  DISHES.forEach(function (d, i) {
    var li = document.createElement("li");
    li.className = "dish"; li.dataset.cat = d[0]; li.dataset.i = i;
    li.innerHTML = '<span class="cat">' + CAT[d[0]] + "</span><h3>" + d[1] + "</h3><p>" + d[2] + "</p>" +
      '<button class="heart" type="button" aria-pressed="false" aria-label="Quiero probar ' + d[1] + '"><svg><use href="#i-heart"/></svg></button>';
    li.querySelector(".heart").addEventListener("click", function () {
      var k = want.indexOf(d[1]);
      if (k >= 0) want.splice(k, 1); else want.push(d[1]);
      store.set("albania-comida-v1", want);
      paintFood();
    });
    dishesEl.appendChild(li);
  });
  function paintFood() {
    $$(".dish", dishesEl).forEach(function (li) {
      var name = DISHES[+li.dataset.i][1], on = want.indexOf(name) >= 0;
      li.classList.toggle("want", on);
      li.querySelector(".heart").setAttribute("aria-pressed", on ? "true" : "false");
      li.hidden = filter === "want" ? !on : (filter !== "all" && li.dataset.cat !== filter);
    });
    $("#want-n").textContent = want.length;
    $("#food-tally").innerHTML = want.length
      ? "En vuestra lista: <b>" + want.length + "</b> de 17. Se guarda en este navegador."
      : "Marca con el corazón lo que queráis probar. Se guarda en este navegador.";
  }
  $$("#food-filters button").forEach(function (b) {
    b.addEventListener("click", function () {
      filter = b.dataset.f;
      $$("#food-filters button").forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
      paintFood();
    });
  });
  paintFood();

  /* Maleta */
  var PACK = [
    { id: "viaje", trip: true, t: "Lo que pide el itinerario", items: [
      ["Check-in 24 h antes de cada vuelo", "Ida el 4 y vuelta el 14"],
      ["Maleta de mano de 40 × 30 × 20 cm", "Sin equipaje facturado"],
      ["Carné internacional junto al español", "El español solo no vale"],
      ["Tarjeta de crédito del conductor", "Depósito de 500 € del coche"],
      ["Maps.me con la ruta descargada", "Para el trekking sin cobertura"],
      ["Encargar el lunchbox en Valbonë", "Día 3, al hacer el check-in"],
      ["Gorra, crema y agua para el paso", "Día 4"],
      ["Bañador, toalla y ropa ligera", "Barcos de los días 8 y 9"]
    ] },
    { id: "doc", t: "Documentación personal", items: ["DNI", "Carné de conducir", "Carné internacional", "Pasaporte", "Certificado COVID", "Documentación de viaje", "Dinero en efectivo", "Tarjeta de crédito", "Tarjeta sanitaria", "Seguro médico de viaje"] },
    { id: "nec", t: "Neceser personal", items: ["Champú, acondicionador y gel", "Cepillo o peine", "Pasta y cepillo de dientes", "Perfume", "Lentillas y solución líquida", "Higiene femenina", "Secador y planchas", "Crema hidratante", "Desodorante", "Maquillaje", "Pañuelos", "Cuchilla, máquina de afeitar, depiladora", "Cortaúñas, tijeritas, pinzas"] },
    { id: "bot", t: "Botiquín", items: [["Medicamentos básicos", "Analgésicos, antiinflamatorios, antibióticos, protector de estómago, pastillas para el mareo, laxantes y antidiarreicos"], "Crema solar y after sun", "Tiritas y gasas", "Repelente y afterbite", "Gel desinfectante"] },
    { id: "ropa", t: "Ropa de viaje", items: ["Camisetas y camisas", "Pantalones y faldas", "Sudaderas y jerséis", "Vestidos y monos", "Chaquetas y abrigos", "Ropa interior", "Pijama y zapatillas", "Bañador y bikini", "Gorras y sombreros", "Bambas, zapatos, calzado elegante", "Gafas de sol", "Escarpines y chanclas", "Paraguas de bolsillo, chubasquero"] },
    { id: "tec", t: "Tecnología y entretenimiento", items: ["Itinerario y guía de viaje", "Adaptador de corriente universal, regleta", "Batería portátil", "Auriculares inalámbricos", "Almohada, antifaz y tapones", "Cámara fotográfica, acuática, dron…", "Móvil y tablet u ordenador", "Libro o e-book", "Cargador de móvil", "Bolsa impermeable"] }
  ];
  var packed = store.get("albania-maleta-v1", {});
  if (!packed || typeof packed !== "object") packed = {};
  var packsEl = $("#packs"), totalItems = 0;
  PACK.forEach(function (cat) {
    var box = document.createElement("div");
    box.className = "pack" + (cat.trip ? " trip" : ""); box.dataset.cat = cat.id;
    var html = "<header><h3>" + cat.t + '</h3><span class="cnt"></span></header><ul>';
    cat.items.forEach(function (it, i) {
      var label = Array.isArray(it) ? it[0] : it, sub = Array.isArray(it) ? "<small>" + it[1] + "</small>" : "";
      var id = "pk-" + cat.id + "-" + i;
      html += '<li><label class="check" for="' + id + '"><input type="checkbox" id="' + id + '"><span>' + label + sub + "</span></label></li>";
      totalItems++;
    });
    box.innerHTML = html + "</ul>";
    packsEl.appendChild(box);
  });
  var boxes = $$("#packs input[type=checkbox]");
  boxes.forEach(function (b) {
    b.checked = !!packed[b.id];
    b.addEventListener("change", function () {
      if (b.checked) packed[b.id] = 1; else delete packed[b.id];
      store.set("albania-maleta-v1", packed);
      paintPack();
    });
  });
  var bar = $("#pack-bar");
  function paintPack() {
    var done = boxes.filter(function (b) { return b.checked; }).length;
    $("#pack-text").innerHTML = "<b>" + done + "</b> de " + totalItems + " en la maleta";
    bar.firstElementChild.style.width = (100 * done / totalItems) + "%";
    bar.setAttribute("aria-valuemax", totalItems); bar.setAttribute("aria-valuenow", done);
    $$(".pack", packsEl).forEach(function (p) {
      var cb = $$("input", p), d = cb.filter(function (x) { return x.checked; }).length;
      p.querySelector(".cnt").textContent = d + "/" + cb.length;
      p.classList.toggle("done", d === cb.length);
    });
  }
  paintPack();
  var ask = $("#reset-ask"), confirmBox = $("#reset-confirm");
  ask.addEventListener("click", function () { ask.hidden = true; confirmBox.hidden = false; $("#reset-no").focus(); });
  $("#reset-no").addEventListener("click", function () { confirmBox.hidden = true; ask.hidden = false; ask.focus(); });
  $("#reset-yes").addEventListener("click", function () {
    boxes.forEach(function (b) { b.checked = false; });
    packed = {}; store.set("albania-maleta-v1", packed); paintPack();
    confirmBox.hidden = true; ask.hidden = false; ask.focus();
  });

  /* Visor de fotos */
  var shots = $$("[data-lb]"), lb = $("#lb"), lbImg = $("#lb-img"), lbCap = $("#lb-cap"), lbCount = $("#lb-count"), cur = 0, lastFocus = null;
  function showShot(i) {
    cur = (i + shots.length) % shots.length;
    var b = shots[cur], img = b.querySelector("img");
    lbImg.src = img.src; lbImg.alt = img.alt;
    lbCap.textContent = b.dataset.lb;
    lbCount.textContent = (cur + 1) + " / " + shots.length;
  }
  function openLb(i) { lastFocus = document.activeElement; showShot(i); lb.hidden = false; document.body.style.overflow = "hidden"; $("#lb-close").focus(); }
  function closeLb() { lb.hidden = true; document.body.style.overflow = ""; if (lastFocus) lastFocus.focus({ preventScroll: true }); }
  shots.forEach(function (b, i) { b.addEventListener("click", function () { openLb(i); }); });
  $("#lb-close").addEventListener("click", closeLb);
  $("#lb-prev").addEventListener("click", function () { showShot(cur - 1); });
  $("#lb-next").addEventListener("click", function () { showShot(cur + 1); });
  lb.addEventListener("click", function (e) { if (e.target === lb || e.target.classList.contains("lb-fig")) closeLb(); });
  var tx = null;
  lb.addEventListener("touchstart", function (e) { tx = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener("touchend", function (e) { if (tx === null) return; var dx = e.changedTouches[0].clientX - tx; if (Math.abs(dx) > 50) showShot(cur + (dx < 0 ? 1 : -1)); tx = null; });

  /* Teclado */
  document.addEventListener("keydown", function (e) {
    if (!lb.hidden) {
      if (e.key === "Escape") closeLb();
      else if (e.key === "ArrowRight") showShot(cur + 1);
      else if (e.key === "ArrowLeft") showShot(cur - 1);
      return;
    }
    if (e.key === "Escape" && mapEl.classList.contains("is-sheet")) { closeSheet(); return; }
    var tag = (e.target.tagName || "").toLowerCase();
    if (tag === "input" || tag === "textarea" || e.target.getAttribute("role") === "tab" || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === "ArrowRight") { e.preventDefault(); goDay(active ? active + 1 : 1); }
    else if (e.key === "ArrowLeft") { e.preventDefault(); goDay(active ? active - 1 : 1); }
  });

  /* Volver al portfolio en el idioma de donde se viene */
  try {
    var ref = document.referrer ? new URL(document.referrer) : null;
    if (ref && ref.origin === location.origin) {
      var seg = ref.pathname.split("/")[1];
      if (seg === "en" || seg === "ca") { $("#nm-back").href = "/" + seg + "/#planificaciones"; $("#foot-back").href = "/" + seg + "/#planificaciones"; }
    }
  } catch (e) {}

  /* Arranque */
  setVB(fullBox());
  var m = /^#dia-(\d+)$/.exec(location.hash);
  if (m) setActive(+m[1]);
})();
</script>
</body>
</html>
