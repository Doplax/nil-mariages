---
// Planificación interactiva «Albania en 11 días» (muestra de portfolio).
// El contenido sale del PDF public/planificaciones/albania-muestra.pdf y, como
// el PDF, está solo en castellano: desde /en y /ca se enlaza aquí igualmente.
// Aquí va el texto de cada día; el mapa, los platos, la maleta y el conversor
// salen de src/data/plans/albania.ts, y el resto, de src/layouts/PlanLayout.astro.
// Fotos: public/images/planificaciones/albania/ (scripts/plan-images.mjs).
// Contorno del mapa: src/data/plans/albania-map.json (scripts/build-plan-map.mjs).
import PlanLayout from '../../layouts/PlanLayout.astro';
import PlanPhoto from '../../components/plan/PlanPhoto.astro';
import PlanConverter from '../../components/plan/PlanConverter.astro';
import { albania } from '../../data/plans/albania';
import map from '../../data/plans/albania-map.json';
import sizes from '../../data/plans/albania-images.json';

const pdfUrl = `/visor?src=${encodeURIComponent('/planificaciones/albania-muestra.pdf')}&title=${encodeURIComponent('Albania en 11 días')}`;
const img = (name: string) => `/images/planificaciones/albania/${name}.webp`;
---

<PlanLayout
  plan={albania}
  map={map}
  title="Albania en 11 días"
  description="Planificación interactiva de un viaje en coche por Albania del 4 al 14 de septiembre de 2025, por Nil Mariages."
  brand="Albania"
  brandYear="2025"
  pdfUrl={pdfUrl}
  mapLabel="Mapa de Albania con la ruta del viaje"
  footerTitle="Albania 2025"
>
<section id="inicio" aria-label="Portada" slot="hero">
  <img class="hero-photo" src={img('berat-panorama')} srcset={`${img('berat-panorama-480')} 480w, ${img('berat-panorama')} 1200w`} sizes="100vw" width="1200" height="287" alt="Casas otomanas blancas en la ladera de Berat" fetchpriority="high">
  <div class="wrap hero">
    <div>
      <p class="eyebrow">Shqipëria · Planificación de viaje</p>
      <h1>Albania<span>en 11 días</span></h1>
      <p class="dates">Jueves 4 – domingo 14 de septiembre de 2025</p>
      <p class="lead">Un viaje en coche de norte a sur: el ferri del lago Koman, el paso de Valbonë a Theth, Berat, Gjirokastër y Butrinto, y dos días en barco por la Riviera albanesa.</p>
      <div class="cta">
        <a class="btn solid" href="#dia-1">Empezar por el día 1</a>
        <a class="btn" href="#ruta">Ver la ruta en el mapa</a>
      </div>
      <p class="byline">Planificación de <b>Nil Mariages</b> · Muestra de portfolio, no reproducir</p>
    </div>
    <ul class="stats" aria-label="El viaje en cifras">
      <li><b>11</b><span>días</span></li>
      <li><b>10</b><span>noches</span></li>
      <li><b>8</b><span>alojamientos</span></li>
      <li><b>3</b><span>sitios UNESCO</span></li>
      <li><b>2</b><span>tours en barco</span></li>
      <li><b>1</b><span>trekking</span></li>
    </ul>
  </div>
</section>

<div class="checkin" slot="hero"><div class="wrap"><p>Acordaos de hacer el check-in 24 horas antes de cada vuelo</p></div></div>


      <!-- DIA 1 -->
      <article class="day" id="dia-1" data-day="1">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>01</b></div>
          <div>
            <p class="day-date">Jueves 4 sep</p>
            <h3 class="day-route">Barcelona <i>→</i> Tiranë</h3>
            <ul class="tags"><li>Vuelo</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Forest Park Hotel Krujë</b><span class="stars" aria-label="4 estrellas">★★★★</span><span class="regimen">Alojamiento y desayuno</span></div>
        <ul class="keys">
          <li><b>22:35</b>despegue</li>
          <li><b>W4 5154</b>Wizz Air</li>
          <li><b>T2</b>El Prat</li>
        </ul>
        <ol class="flow">
          <li><span class="when">2 h antes</span><div class="step"><p>Llegad al aeropuerto de Barcelona – El Prat, terminal 2. Como no lleváis equipaje facturado, id directos al control de seguridad.</p></div></li>
          <li class="fixed"><span class="when">22:35</span><div class="step"><p>Sale el vuelo W4 5154 de Wizz Air con dirección <button class="place" type="button" data-stop="tia">Tirana</button>.</p></div></li>
        </ol>
        <div class="note-box"><h4>Equipaje permitido por persona</h4><p>Una pieza de equipaje de mano de 40 × 30 × 20 cm como máximo, según las normas de la aerolínea (pueden cambiar).</p></div>
        <nav class="day-nav" aria-label="Cambiar de día"><span></span><a href="#dia-2">Día 2 →</a></nav>
      </article>

      <!-- DIA 2 -->
      <article class="day" id="dia-2" data-day="2">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>02</b></div>
          <div>
            <p class="day-date">Viernes 5 sep</p>
            <h3 class="day-route">Tiranë <i>→</i> Krujë <i>→</i> Shkodër</h3>
            <ul class="tags"><li>Coche de alquiler</li><li>Castillos</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Centropolis Apartments</b><span class="stars" aria-label="3 estrellas">★★★</span><span class="regimen">Sólo alojamiento</span></div>
        <ul class="keys">
          <li><b>01:05</b>llegada a Tirana</li>
          <li><b>500 €</b>depósito del coche</li>
          <li><b>85 km</b>≈ 1 h 40 Krujë → Shkodër</li>
        </ul>
        <div class="photos">
          <PlanPhoto plan="albania" sizes={sizes} name="kruje" alt="Krujë con su castillo en lo alto" caption="Krujë" />
          <PlanPhoto plan="albania" sizes={sizes} name="rozafa" alt="Castillo de Rozafa visto desde el aire" caption="Castillo de Rozafa, Shkodër" />
        </div>
        <ol class="flow">
          <li class="fixed"><span class="when">01:05</span><div class="step"><p>Llegada al aeropuerto de <button class="place" type="button" data-stop="tia">Tirana</button>. Pasad el control de pasaportes y, a la salida de la terminal, seguid el bono de alquiler hasta la oficina de Green Motion.</p></div></li>
          <li><span class="when">+30 min</span><div class="step"><p>Con el coche ya revisado, media hora hasta el hotel en Krujë. Check-in y a descansar.</p></div></li>
          <li><span class="when">Mañana</span><div class="step"><p><button class="place" type="button" data-stop="kruje">Krujë</button>, a diez minutos. Empezad en el mirador del castillo y bajad por el Antiguo Bazar, con alfombras tejidas a mano, cerámica, bordados y cobre, hasta la Mezquita Kruja Murad Bey.</p><p class="sub">Dentro del castillo: Museo Nacional Gjergj Kastrioti Skanderbeg, Torre de vigilancia, Museo Etnográfico en una casa otomana y el santuario bektashi Teqeja e Dollmës.</p></div></li>
          <li><span class="when">85 km</span><div class="step"><p>Hacia el norte, cerca de una hora y cuarenta minutos hasta Shkodër.</p></div></li>
          <li><span class="when">Tarde</span><div class="step"><p>Subid al <button class="place" type="button" data-stop="shkoder">Castillo de Rozafa</button>, sobre la confluencia de los ríos Buna y Drin, y a sus pies la Mezquita de Plomo. Check-in y el coche bien aparcado: no lo necesitaréis en dos días.</p><p class="sub">Paseo por el centro: Mezquita Ebu Bekr, Iglesia de la Natividad de Cristo, calle Kole Idromeno, calle G’juhadol y Catedral de San Esteban.</p></div></li>
          <li><span class="when">Noche</span><div class="step"><p>Cena con pescado del lago o guisos tradicionales, y pronto al hotel.</p></div></li>
        </ol>
        <details class="more">
          <summary>Recoger el coche de alquiler</summary>
          <div class="in">
            <p>Documentos originales, sin fotocopias, a nombre del conductor titular (Nil Mariages Nebot):</p>
            <ul>
              <li>Tarjeta de crédito VISA o Mastercard.</li>
              <li>DNI o pasaporte.</li>
              <li>Permiso de conducir válido, con el internacional.</li>
            </ul>
            <p style="margin-top:10px">La Cobertura Premium ya está incluida. Si os ofrecen su seguro, decid que no y manteneos firmes. El depósito es de 500 € (está en el bono) y hay que pagar 25 € por recoger fuera del horario de oficina.</p>
            <p>Antes de arrancar, haced fotos y vídeos del exterior y del interior: golpes, arañazos y desperfectos que ya tenga. Comprobad también la rueda de repuesto, el chaleco y el triángulo.</p>
          </div>
        </details>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-1">← Día 1</a><a href="#dia-3">Día 3 →</a></nav>
      </article>

      <!-- DIA 3 -->
      <article class="day" id="dia-3" data-day="3">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>03</b></div>
          <div>
            <p class="day-date">Sábado 6 sep</p>
            <h3 class="day-route">Shkodër <i>→</i> Lago Koman <i>→</i> Valbonë</h3>
            <ul class="tags"><li class="t-mont">Montaña</li><li class="t-mar">Ferri</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Guesthouse Demushi</b><span class="stars" aria-label="3 estrellas">★★★</span><span class="regimen">Alojamiento y desayuno</span></div>
        <ul class="keys">
          <li><b>06:30</b>en la puerta del Hotel Rozafa</li>
          <li><b>06:45</b>sale el transfer</li>
          <li><b>≈ 2 h</b>de ferri</li>
        </ul>
        <div class="photos">
          <PlanPhoto plan="albania" sizes={sizes} name="koman" alt="El lago Koman entre paredes de roca" caption="Lago Koman" />
          <PlanPhoto plan="albania" sizes={sizes} name="valbone" alt="El valle de Valbonë rodeado de picos" caption="Valle de Valbonë" />
        </div>
        <ol class="flow">
          <li class="fixed"><span class="when">06:30</span><div class="step"><p>En punto en la puerta del Hotel Rozafa. El transfer sale a las 06:45 y no espera a nadie: unas dos horas por carreteras de montaña cada vez más estrechas.</p></div></li>
          <li><span class="when">Koman</span><div class="step"><p>Tras un túnel excavado en la roca, el embarcadero de <button class="place" type="button" data-stop="koman">Koman</button>. El ferri público tarda unas dos horas hasta Fierzë, entre cañones y aguas verde esmeralda. Una de las travesías más bonitas de Europa.</p></div></li>
          <li class="fixed"><span class="when">≈ 12:00</span><div class="step"><p>En el muelle de <button class="place" type="button" data-stop="fierze">Fierzë</button> os espera otro traslado: aproximadamente una hora hasta el valle de Valbonë.</p></div></li>
          <li><span class="when">Check-in</span><div class="step"><p>En la guesthouse de <button class="place" type="button" data-stop="valbone">Valbonë</button>, reservad la cena y encargad el <em>lunchbox</em> para el trekking de mañana.</p></div></li>
          <li><span class="when">Tarde</span><div class="step"><p>Tarde libre: paseo por las praderas y los puentes de madera, baño en Buga Dam o un té en la terraza viendo cómo cae la luz sobre las cumbres.</p></div></li>
          <li><span class="when">Noche</span><div class="step"><p>Cenad temprano y a descansar: mañana toca madrugar.</p></div></li>
        </ol>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-2">← Día 2</a><a href="#dia-4">Día 4 →</a></nav>
      </article>

      <!-- DIA 4 -->
      <article class="day" id="dia-4" data-day="4">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>04</b></div>
          <div>
            <p class="day-date">Domingo 7 sep</p>
            <h3 class="day-route">Valbonë <i>→</i> Theth <i>→</i> Shkodër</h3>
            <ul class="tags"><li class="t-mont">Trekking</li><li class="t-mont">Alpes albaneses</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Centropolis Apartments</b><span class="stars" aria-label="3 estrellas">★★★</span><span class="regimen">Sólo alojamiento</span></div>
        <ul class="keys">
          <li><b>Valbona Pass</b>de valle a valle</li>
          <li><b>16:45</b>Mini Market Jezerca</li>
          <li><b>≈ 2 h</b>traslado a Shkodër</li>
        </ul>
        <div class="photos">
          <PlanPhoto plan="albania" sizes={sizes} name="valbona-pass" alt="Senderista ante los picos de los Alpes albaneses" caption="Ruta de Valbonë a Theth" />
          <PlanPhoto plan="albania" sizes={sizes} name="theth" alt="La iglesia de piedra de Theth con montañas detrás" caption="Iglesia de Theth" />
        </div>
        <ol class="flow">
          <li><span class="when">Salida</span><div class="step"><p>La ruta empieza a la altura del Fusha e Gjes Hotel, siguiendo el cauce de un río seco. Si la guesthouse os acerca en coche hasta donde se puede, os ahorráis unos 3 km.</p></div></li>
          <li><span class="when">Tramo 1</span><div class="step"><p>Subida por el bosque hasta una pradera con un pequeño refugio y una fuente. Primera pausa.</p></div></li>
          <li><span class="when">Tramo 2</span><div class="step"><p>El tramo más exigente, casi sin sombra, hasta el paso entre los dos valles: el punto más alto y el mejor mirador. Buen sitio para sentarse, comer algo y hacer fotos.</p></div></li>
          <li><span class="when">Bajada</span><div class="step"><p>Pronunciada y dura para las rodillas: con calma, entre bosques y praderas, hasta <button class="place" type="button" data-stop="theth">Theth</button>.</p></div></li>
          <li><span class="when">Theth</span><div class="step"><p>La Iglesia de Theth, que sobrevivió a décadas de aislamiento comunista, y la torre Kulla e Ngujimit, ligada al Kanun, el código de leyes consuetudinarias albanés.</p></div></li>
          <li class="fixed"><span class="when">16:45</span><div class="step"><p>Quince minutos antes de las 17:00, en el Mini Market Jezerca. Traslado de unas dos horas de vuelta a <button class="place" type="button" data-stop="shkoder">Shkodër</button>.</p></div></li>
        </ol>
        <div class="note-box">
          <h4>Para el trekking</h4>
          <ul>
            <li>Marcas blancas y rojas, pero pocos carteles. Si dudáis, los pastores os indicarán aunque no hablen inglés.</li>
            <li>Llevad la ruta en <a href="https://apps.apple.com/es/app/maps-me-mapas-sin-conexi%C3%B3n/id510623322" target="_blank" rel="noopener">Maps.me</a>, que funciona sin conexión.</li>
            <li>Gorra, crema solar y agua suficiente: el sol castiga en la subida.</li>
            <li><a href="https://es.wikiloc.com/rutas-senderismo/valbone-theth-albania-144517178" target="_blank" rel="noopener">La ruta en Wikiloc</a></li>
          </ul>
        </div>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-3">← Día 3</a><a href="#dia-5">Día 5 →</a></nav>
      </article>

      <!-- DIA 5 -->
      <article class="day" id="dia-5" data-day="5">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>05</b></div>
          <div>
            <p class="day-date">Lunes 8 sep</p>
            <h3 class="day-route">Shkodër <i>→</i> Berat</h3>
            <ul class="tags"><li class="t-unesco">UNESCO</li><li>Ciudad otomana</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Mili Hotel</b><span class="regimen">Alojamiento y desayuno</span></div>
        <ul class="keys">
          <li><b>196 km</b>≈ 3 h</li>
          <li><b>A pie</b>por el casco histórico</li>
        </ul>
        <div class="photos">
          <PlanPhoto plan="albania" sizes={sizes} name="berat" alt="Casas blancas de Berat en terrazas sobre la ladera al atardecer" caption="Berat" wide />
        </div>
        <ol class="flow">
          <li><span class="when">196 km</span><div class="step"><p>Uno de los tramos más largos: unas tres horas por colinas, zonas rurales y pueblos pequeños. Al llegar a <button class="place" type="button" data-stop="berat">Berat</button>, aparcad y seguid a pie.</p></div></li>
          <li><span class="when">Castillo</span><div class="step"><p>El Castillo de Berat sigue habitado. Dentro: el Museo Nacional Iconográfico Onufri en la Catedral de la Dormición, la Capilla de la Sagrada Trinidad y las ruinas de la Mezquita Roja.</p><p class="sub">Desde el mirador se ven Mangalem y Gorica, con sus casas blancas en terrazas, y el río Osum.</p></div></li>
          <li><span class="when">Gorica</span><div class="step"><p>Bajando, la Iglesia de San Miguel. Cruzad el Puente de Gorica, de piedra y del siglo XVIII, pasead por el barrio y acercaos al Ura e Varur, el puente colgante.</p></div></li>
          <li><span class="when">Mangalem</span><div class="step"><p>Arquitectura otomana: Mezquita de los Solteros, Mezquita del Rey (la más antigua de Berat) y Mezquita de Plomo. También la Catedral de San Demetrio.</p></div></li>
          <li><span class="when">Atardecer</span><div class="step"><p>Una terraza en el Bulevardi Republika, con el río delante, mientras el sol dora las fachadas.</p></div></li>
        </ol>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-4">← Día 4</a><a href="#dia-6">Día 6 →</a></nav>
      </article>

      <!-- DIA 6 -->
      <article class="day" id="dia-6" data-day="6">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>06</b></div>
          <div>
            <p class="day-date">Martes 9 sep</p>
            <h3 class="day-route">Berat <i>→</i> Cañón de Langarica <i>→</i> Gjirokastër</h3>
            <ul class="tags"><li>El tramo más largo</li><li class="t-mont">Cañón</li><li class="t-unesco">UNESCO</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Elisavet’s Room</b><span class="regimen">Sólo alojamiento</span></div>
        <ul class="keys">
          <li><b>278 km</b>≈ 4 h 30</li>
          <li><b>+1 h</b>desvío a Langarica</li>
          <li><b>1 h 20</b>Langarica → Gjirokastër</li>
        </ul>
        <div class="photos">
          <PlanPhoto plan="albania" sizes={sizes} name="puente-benje" alt="Puente otomano de piedra sobre el río Langarica" caption="Puente de Bënjë" lb="Puente de Bënjë, Cañón de Langarica" />
          <PlanPhoto plan="albania" sizes={sizes} name="gjirokaster" alt="Torre del reloj del castillo de Gjirokastër" caption="Gjirokastër" />
        </div>
        <ol class="flow">
          <li><span class="when">278 km</span><div class="step"><p>El tramo de coche más largo del viaje, por montañas, valles y pueblos poco transitados. El Cañón de Osumi no es recomendable sin 4x4; en su lugar, un desvío de una hora al Cañón de Langarica.</p></div></li>
          <li><span class="when">Langarica</span><div class="step"><p>En <button class="place" type="button" data-stop="benje">Bënjë</button>, pueblo de aguas termales, un puente otomano de piedra marca la entrada al cañón. Paredes de caliza de hasta 150 metros, agua turquesa y pozas templadas para bañarse. En verano, tramos vadeando el río.</p></div></li>
          <li><span class="when">Mediodía</span><div class="step"><p>Una hora y veinte hasta <button class="place" type="button" data-stop="gjirokaster">Gjirokastër</button>, “la ciudad de piedra” por sus tejados de pizarra. Ciudad natal de Enver Hoxha. Comida y check-in.</p></div></li>
          <li><span class="when">Tarde</span><div class="step"><p>Skënduli House y Zekate House, dos casas otomanas; el Bazar y su mezquita; el Obelisco de la Educación, mirador sobre el casco antiguo, y el Cold War Tunnel, construido en la dictadura.</p></div></li>
          <li><span class="when">Castillo</span><div class="step"><p>Uno de los más grandes de los Balcanes, con vistas al valle del Drino. Museo de armas, la Clock Tower y el escenario del Festival Nacional de Folklore.</p></div></li>
          <li><span class="when">Atardecer</span><div class="step"><p>Si da tiempo, el Ali Pasha Bridge, un antiguo acueducto en las afueras.</p></div></li>
        </ol>
        <nav class="day-nav" aria-label="Cambiar de día"><a href="#dia-5">← Día 5</a><a href="#dia-7">Día 7 →</a></nav>
      </article>

      <!-- DIA 7 -->
      <article class="day" id="dia-7" data-day="7">
        <div class="day-head">
          <div class="day-num"><small>Día</small><b>07</b></div>
          <div>
            <p class="day-date">Miércoles 10 sep</p>
            <h3 class="day-route">Gjirokastër <i>→</i> Ksamil</h3>
            <ul class="tags"><li class="t-mar">Playa</li><li class="t-unesco">UNESCO</li></ul>
          </div>
        </div>
        <div class="stay"><svg><use href="#i-bed"/></svg><b>Hotel Perla Ksamil</b><span class="stars" aria-label="3 estrellas">★★★</span><span class="regimen">Alojamiento y desayuno</span></div>
        <ul class="keys">
          <li><b>65 km</b>≈ 1 h 15</li>
          <li><b>Blue Eye</b>parada a medio camino</li>
        </ul>
        <div class="photos">
          <PlanPhoto plan="albania" sizes={sizes} name="blue-eye" alt="El manantial azul intenso del Blue Eye" caption="Blue Eye (Syri i Kaltër)" />
          <PlanPhoto plan="albania" sizes={sizes} name="ksamil" alt="Agua turquesa frente a una isla en Ksamil" caption="Ksamil" />
        </div>
        <ol class="flow">
          <li><span class="when">Mañana</span><div class="step"><p>A medio camino, el <button class="place" type="button" data-stop="blueeye">Blue Eye</button>: un manantial con forma de iris que brota de una cueva de más de 50 metros, según las estimaciones. Ya no se puede nadar; se ve desde pasarelas y miradores.</p></div></li>
          <li><span class="when">Butrinto</span><div class="step"><p>Directos a <button class="place" type="button" data-stop="butrint">Butrinto</button>, dentro de un parque natural: anfiteatro romano, termas, basílica paleocristiana, baptisterio con mosaicos, Puerta del León y murallas medievales.</p></div></li>
          <li><span class="when">Comida</span><div class="step"><p>Restaurante y check-in en <button class="place" type="button" data-stop="ksamil">Ksamil</button>.</p></div></li>
          <li><span class="when">Tarde</span><div class="step"><p>Playa hasta el atardecer. Elegid:</p><p class="sub"><b>Ksamil Beach</b>, la más famosa, con islas a las que se llega nadando, en kayak o en barca. <b>Mirror Beach</b>, más salvaje y buena para snorkel. <b>Plazhi i Manastirit</b>, la más tranquila, junto a un antiguo monasterio.</p></div></li>
        </ol>
